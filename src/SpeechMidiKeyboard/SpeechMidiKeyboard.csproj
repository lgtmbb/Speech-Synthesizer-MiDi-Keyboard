<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Without this the SDK defaults OutputType to Library, which also silently
         disables the WinForms ApplicationConfiguration.Initialize() source generator
         used in Program.cs. Must be an executable for a desktop app. -->
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0 gives us WinRT projections for Windows.Media.SpeechSynthesis,
         which is how OneCore voices are consumed from a Win32/WinForms app. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <!-- Declared here (not just passed to `dotnet publish -r win-x64`) so that a plain
         `dotnet restore`/`dotnet restore SpeechMidiKeyboard.sln` step - the kind CI runs
         before publish - already knows to fetch the win-x64 runtime pack. Without this,
         restore and publish can disagree about the RID and fail with NETSDK1112. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWinRT>true</UseWinRT>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>SpeechMidiKeyboard</AssemblyName>
    <RootNamespace>SpeechMidiKeyboard</RootNamespace>
    <Authors>lgtmbb</Authors>
    <Product>Speech Synthesizer MIDI Keyboard</Product>
    <!-- Portable: no installer, self-contained single exe published with:
         dotnet publish -c Release -r win-x64 -p:SelfContained=true
           -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- SAPI5 access from .NET (System.Speech is Windows-only, ships as a NuGet package). -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

</Project>
